---
import { COPY, type Locale } from '../../i18n/translations';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = COPY[locale].howItWorks;
---

<section
	id="how-it-works"
	aria-labelledby="how-heading"
	class="border-t border-ink/10 bg-surface px-6 py-24 text-ink md:px-8 lg:px-10"
>
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
			<div>
				<span class="text-[10px] font-bold tracking-[0.2em] text-brand-accent">
					{t.eyebrow}
				</span>
				<h2 id="how-heading" class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
					{t.heading}
				</h2>
				<p class="mt-3 max-w-xl text-sm text-ink/65">{t.subtitle}</p>
			</div>
			<p class="max-w-xs rounded-xl border border-ink/10 bg-surface-elevated/60 px-4 py-3 text-xs leading-relaxed text-ink/70">
				{t.pricingNote}
			</p>
		</div>

		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{
				t.steps.map((step) => (
					<article class="rounded-2xl border border-ink/10 bg-surface-elevated/50 p-6 transition hover:border-ink/25">
						<span class="inline-block rounded-md bg-brand/20 px-2.5 py-1 text-xs font-bold tracking-widest text-brand-accent">
							{step.number}
						</span>
						<h3 class="mt-4 text-lg font-bold tracking-tight text-ink">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink/65">{step.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
