---
import { BrandIcon } from './BrandIcon';
import { COPY, getNavLinks, type Locale } from '../../i18n/translations';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = COPY[locale];
const navLinks = getNavLinks(locale);
const year = new Date().getFullYear();
---

<footer
	id="contact"
	class="border-t border-ink/10 bg-surface py-12 text-ink"
>
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 md:flex-row md:items-center md:justify-between md:px-8 lg:px-10">
		<div class="flex flex-col gap-3">
			<a
				href="#top"
				class="flex items-center gap-2.5 text-sm font-black tracking-[0.2em]"
				aria-label={t.nav.homeAria}
			>
				<BrandIcon />
				ITINERIA
			</a>
			<p class="max-w-xs text-xs leading-relaxed text-ink/55">
				{t.footer.tagline}
			</p>
		</div>

		<nav class="flex flex-wrap gap-6 text-sm text-ink/65" aria-label={t.footer.navAria}>
			{
				navLinks.map((link) => (
					<a href={link.href} class="transition hover:text-ink">
						{link.label}
					</a>
				))
			}
		</nav>
	</div>

	<div class="mt-10 border-t border-ink/10 pt-6">
		<div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 text-xs text-ink/45 sm:flex-row sm:items-center sm:justify-between md:px-8 lg:px-10">
			<span>&copy; {year} ItineriaPlan. {t.footer.rights}</span>
			<span>{t.footer.contactLabel}: {t.footer.email} · {t.footer.hours}</span>
		</div>
	</div>
</footer>
