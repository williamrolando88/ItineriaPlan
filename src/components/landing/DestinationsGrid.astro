---
import { ArrowRight } from 'lucide-react';
import { getSlides } from '../../data/hero';
import { COPY, type Locale } from '../../i18n/translations';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = COPY[locale].destinations;
const slides = getSlides(locale);
---

<section
	id="destinations"
	aria-labelledby="destinations-heading"
	class="border-t border-ink/10 bg-surface px-6 py-24 text-ink md:px-8 lg:px-10"
>
	<div class="mx-auto max-w-6xl">
		<span class="text-[10px] font-bold tracking-[0.2em] text-brand-accent">
			{t.eyebrow}
		</span>
		<h2 id="destinations-heading" class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
			{t.heading}
		</h2>
		<p class="mt-3 max-w-xl text-sm text-ink/65">{t.subtitle}</p>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				slides.map((item) => (
					<article class="group flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-surface-elevated/50 transition hover:border-ink/25">
						<div class="relative h-52 overflow-hidden">
							<img
								src={item.cardImage}
								alt={`${item.title}, ${item.tag}`}
								loading="lazy"
								class="size-full object-cover transition duration-500 group-hover:scale-105"
							/>
							<span class="absolute inset-0 bg-gradient-to-t from-surface/90 via-surface/20 to-transparent" />
							<span class="absolute left-4 top-4 rounded-md bg-brand px-2.5 py-1 text-[10px] font-bold tracking-[0.14em] text-ink">
								{item.tag}
							</span>
						</div>

						<div class="flex flex-1 flex-col p-6">
							<div class="flex items-center justify-between text-[11px] font-semibold tracking-wide text-ink/55">
								<span>{item.duration}</span>
								<span>{item.styleLabel}</span>
							</div>
							<h3 class="mt-2 text-lg font-extrabold tracking-tight text-ink">
								{item.title}
							</h3>
							<p class="mt-2 flex-1 text-sm leading-relaxed text-ink/65">
								{item.description}
							</p>
							<a
								href={`#quote`}
								class="mt-5 inline-flex items-center gap-2 text-xs font-bold tracking-wide text-brand-accent transition hover:text-ink"
							>
								{t.quoteCta}
								<ArrowRight className="size-3.5" aria-hidden="true" />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
