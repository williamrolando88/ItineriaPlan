---
import { ArrowRight } from 'lucide-react';
import { getSlides } from '../../data/hero';
import { COPY, type Locale } from '../../i18n/translations';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = COPY[locale].quoteAndAccess;
const slides = getSlides(locale);
---

<section
	id="quote"
	aria-labelledby="quote-heading"
	class="scroll-mt-20 border-t border-ink/10 bg-surface px-6 py-24 text-ink md:px-8 lg:px-10"
>
	<div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
		<div>
			<span class="text-[10px] font-bold tracking-[0.2em] text-brand-accent">
				{t.quoteEyebrow}
			</span>
			<h2 id="quote-heading" class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
				{t.quoteHeading}
			</h2>
			<p class="mt-3 max-w-md text-sm leading-relaxed text-ink/65">{t.quoteSubtitle}</p>
		</div>

		<form
			class="grid gap-4 rounded-3xl border border-ink/10 bg-surface-elevated/50 p-7 sm:grid-cols-2 sm:p-8"
			onsubmit="return false;"
		>
			<label class="flex flex-col gap-1.5 text-xs font-semibold text-ink/75">
				{t.destinationLabel}
				<select
					name="destination"
					class="rounded-xl border border-ink/15 bg-surface px-3.5 py-2.5 text-sm text-ink focus:border-brand-hover focus:outline-none"
				>
					{slides.map((s) => <option value={s.slug}>{s.title} ({s.tag})</option>)}
				</select>
			</label>

			<label class="flex flex-col gap-1.5 text-xs font-semibold text-ink/75">
				{t.datesLabel}
				<input
					type="text"
					name="dates"
					placeholder={t.datesPlaceholder}
					class="rounded-xl border border-ink/15 bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink/35 focus:border-brand-hover focus:outline-none"
				/>
			</label>

			<label class="flex flex-col gap-1.5 text-xs font-semibold text-ink/75">
				{t.travelersLabel}
				<input
					type="number"
					name="travelers"
					min="1"
					defaultValue="2"
					class="rounded-xl border border-ink/15 bg-surface px-3.5 py-2.5 text-sm text-ink focus:border-brand-hover focus:outline-none"
				/>
			</label>

			<label class="flex flex-col gap-1.5 text-xs font-semibold text-ink/75">
				{t.tierLabel}
				<select
					name="tier"
					class="rounded-xl border border-ink/15 bg-surface px-3.5 py-2.5 text-sm text-ink focus:border-brand-hover focus:outline-none"
				>
					{t.tiers.map((tier) => <option value={tier.toLowerCase()}>{tier}</option>)}
				</select>
			</label>

			<div class="mt-2 sm:col-span-2">
				<button
					type="submit"
					class="inline-flex items-center gap-2.5 rounded-xl bg-brand px-6 py-3 text-xs font-bold tracking-wide text-ink shadow-lg shadow-brand/25 transition hover:bg-brand-hover"
				>
					{t.submitCta}
					<ArrowRight className="size-4" aria-hidden="true" />
				</button>
			</div>
		</form>
	</div>
</section>
