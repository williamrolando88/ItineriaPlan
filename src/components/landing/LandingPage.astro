---
import '../../styles/global.css';
import { COPY, getNavLinks, type Locale } from '../../i18n/translations';
import { getSlides } from '../../data/hero';
import { Navbar } from './Navbar';
import HeroCarousel from './HeroCarousel';
import HowItWorks from './HowItWorks.astro';
import DestinationsGrid from './DestinationsGrid.astro';
import QuoteAndAccess from './QuoteAndAccess.astro';
import ReviewsCarousel from './ReviewsCarousel';
import Footer from './Footer.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const copy = COPY[locale];
const navLinks = getNavLinks(locale);
const slides = getSlides(locale);
---

<html lang={locale} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{copy.meta.title}</title>
		<meta name="description" content={copy.meta.description} />
	</head>
	<body class="bg-surface text-ink antialiased">
		<Navbar links={navLinks} locale={locale} client:load />
		<main>
			<HeroCarousel slides={slides} locale={locale} client:load />
			<HowItWorks locale={locale} />
			<DestinationsGrid locale={locale} />
			<QuoteAndAccess locale={locale} />
			<ReviewsCarousel locale={locale} client:visible />
		</main>
		<Footer locale={locale} />
	</body>
</html>
