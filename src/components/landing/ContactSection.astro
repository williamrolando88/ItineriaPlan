---
import { COPY, type Locale } from '../../i18n/translations';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = COPY[locale].contact;
---

<section
	id="contact"
	aria-labelledby="contact-heading"
	class="scroll-mt-20 border-t border-ink/10 bg-surface px-6 py-24 text-ink md:px-8 lg:px-10"
>
	<div class="mx-auto max-w-6xl">
		<span class="text-[10px] font-bold tracking-[0.2em] text-brand-accent">
			{t.eyebrow}
		</span>
		<h2 id="contact-heading" class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
			{t.heading}
		</h2>
		<p class="mt-3 max-w-xl text-sm text-ink/65">{t.subtitle}</p>

		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				t.channels.map((ch) => (
					<div class="rounded-2xl border border-ink/10 bg-surface-elevated/45 p-6">
						<span class="text-[10px] font-bold tracking-[0.18em] text-ink/50 uppercase">
							{ch.label}
						</span>
						<p class="mt-2 text-base font-bold text-ink">{ch.value}</p>
						<p class="mt-1 text-xs text-ink/55">{ch.note}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
